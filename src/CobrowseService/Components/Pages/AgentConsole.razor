@page "/"
@page "/agent"
@using CobrowseService.Auth
@using CobrowseService.Realtime
@using CobrowseService.Sessions
@inject SupportRequestService Requests
@inject JoinTicketService Tickets
@inject IAgentIdentityProvider Agents
@inject RequestNotifier Notifier
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Agent console</PageTitle>

<div class="agent-page">
    @if (_error is not null)
    {
        <p class="notice error">@_error</p>
    }

    @if (_notice is not null)
    {
        <p class="notice">@_notice</p>
    }

    <div class="agent-layout">
        <aside class="cb-sessions">
            <div class="sessions-panel">
                <div class="sessions-auth">
                    Signed in as <strong>@(_agent?.DisplayName ?? "unknown")</strong>
                </div>

                <div class="sessions-head">
                    <h2>Sessions</h2>
                    <span>@_active.Count active · @_pending.Count waiting</span>
                </div>

                <section class="session-group">
                    <h3>Active session</h3>

                    @if (SelectedRequest is { } activeRequest)
                    {
                        <div class="session-row selected session-active">
                            <span class="session-dot"></span>
                            <div class="session-body">
                                <div class="session-line">
                                    <span class="session-user">@activeRequest.User.DisplayName</span>
                                    <span class="session-tenant">@activeRequest.TenantId</span>
                                </div>
                                <div class="session-page" title="@PageLabel(activeRequest)">@PageLabel(activeRequest)</div>
                                @if (activeRequest.AcceptedAt is { } accepted)
                                {
                                    <div class="session-meta">accepted <cb-relative-time since="@Iso(accepted)"></cb-relative-time> ago</div>
                                }

                                <div class="status-row compact">
                                    <span id="cb-link" class="cb-pill">connecting…</span>
                                    <span id="cb-user-state" class="cb-pill">customer offline</span>
                                    <span id="cb-consent-state" class="cb-pill">no consent</span>
                                </div>

                                <div class="session-end">
                                    <md-outlined-button class="cb-end" @onclick="EndAsync">End session</md-outlined-button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="session-empty">No session open.</p>
                    }
                </section>

                <section class="session-group">
                    <h3>Requests</h3>

                    @if (_pending.Count == 0)
                    {
                        <p class="session-empty">No one is waiting.</p>
                    }
                    else
                    {
                        @foreach (var request in _pending)
                        {
                            <div class="session-row">
                                <span class="session-dot pending"></span>
                                <div class="session-body">
                                    <div class="session-line">
                                        <span class="session-user">@request.User.DisplayName</span>
                                        <span class="session-tenant">@request.TenantId</span>
                                    </div>
                                    <div class="session-page" title="@PageLabel(request)">@PageLabel(request)</div>
                                    @if (!string.IsNullOrWhiteSpace(request.Note))
                                    {
                                        <div class="session-note">@request.Note</div>
                                    }
                                    <div class="session-meta">waiting <cb-relative-time since="@Iso(request.CreatedAt)"></cb-relative-time></div>
                                </div>
                                <div class="session-actions">
                                    <md-filled-tonal-button class="cb-accept"
                                                            disabled="@_connecting"
                                                            @onclick="() => AcceptAsync(request.Id)">
                                        Accept
                                    </md-filled-tonal-button>
                                </div>
                            </div>
                        }
                    }
                </section>

                <section class="session-group">
                    <h3>Other sessions</h3>

                    @if (!OtherActive.Any())
                    {
                        <p class="session-empty">No other active sessions.</p>
                    }
                    else
                    {
                        @foreach (var request in OtherActive)
                        {
                            <div class="session-row">
                                <span class="session-dot"></span>
                                <div class="session-body">
                                    <div class="session-line">
                                        <span class="session-user">@request.User.DisplayName</span>
                                        <span class="session-tenant">@request.TenantId</span>
                                    </div>
                                    <div class="session-page" title="@PageLabel(request)">@PageLabel(request)</div>
                                    @if (request.AcceptedAt is { } accepted)
                                    {
                                        <div class="session-meta">accepted <cb-relative-time since="@Iso(accepted)"></cb-relative-time> ago</div>
                                    }
                                </div>
                                <div class="session-actions">
                                    <md-text-button class="cb-open"
                                                    disabled="@_connecting"
                                                    @onclick="() => OpenAsync(request.Id)">
                                        Open
                                    </md-text-button>
                                </div>
                            </div>
                        }
                    }
                </section>
            </div>
        </aside>

        <section class="stage">
            @if (SelectedRequest is not null)
            {
                <div class="mirror-surface">
                    <div class="cb-mirror-shell">
                        <div id="cb-mirror" class="cb-mirror">
                            <div class="cb-empty">Live mirror appears here once the customer grants viewing consent.</div>
                        </div>
                    </div>
                </div>

                <div class="debug-surface">
                    <span id="cb-tool-state" class="cb-tool-state">no element selected</span>

                    <div class="cb-tools">
                        <md-outlined-text-field id="cb-type-input"
                                                label="Text to type into the selected element"></md-outlined-text-field>
                        <md-filled-tonal-button class="cb-send" @onclick="SendTextAsync">Send text</md-filled-tonal-button>
                        <md-outlined-button class="cb-scrolldown" @onclick="ScrollDownAsync">Scroll down</md-outlined-button>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-stage">
                    <strong>No session open</strong>
                    <span>Accept a request or open an active session from the left.</span>
                </div>
            }
        </section>

        
    </div>
</div>

@code {
    private AgentIdentity? _agent;
    private IReadOnlyList<SupportRequestSnapshot> _pending = [];
    private IReadOnlyList<SupportRequestSnapshot> _active = [];
    private string? _selectedRequestId;
    private string? _error;
    private string? _notice;
    private bool _connecting;
    private DotNetObjectReference<AgentConsole>? _self;

    protected override void OnInitialized()
    {
        _agent = Agents.GetCurrent();
        _self = DotNetObjectReference.Create(this);
        Notifier.Changed += OnQueueChanged;
        Refresh();
    }

    private void OnQueueChanged() => _ = InvokeAsync(Refresh);

    private SupportRequestSnapshot? SelectedRequest =>
        _selectedRequestId is null
            ? null
            : _active.FirstOrDefault(request => request.Id == _selectedRequestId);

    private IEnumerable<SupportRequestSnapshot> OtherActive =>
        _active.Where(request => request.Id != _selectedRequestId);

    private static string PageLabel(SupportRequestSnapshot request) =>
        request.Page?.Title ?? request.Page?.Url ?? "—";

    private static string Iso(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("o");

    private void Refresh()
    {
        if (_agent is null)
            return;

        _pending = Requests.ListPending();
        _active = Requests.ListActiveForAgent(_agent.Id);
        StateHasChanged();
    }

    private async Task AcceptAsync(string id)
    {
        if (_agent is null || _connecting)
            return;

        _connecting = true;
        _error = null;
        _notice = null;

        try
        {
            var outcome = await Requests.AcceptAsync(id, _agent);
            if (!outcome.Success)
            {
                _error = outcome.ErrorMessage;
                return;
            }

            await ConnectAsync(id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task OpenAsync(string id)
    {
        if (_agent is null || _connecting)
            return;

        _connecting = true;
        _error = null;
        _notice = null;

        try
        {
            await ConnectAsync(id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task ConnectAsync(string id)
    {
        if (_agent is null)
            return;

        var ticket = Tickets.Issue(id, TicketKind.Agent, _agent.Id, TimeSpan.FromMinutes(10));
        _selectedRequestId = id;
        Refresh();

        await JS.InvokeVoidAsync("cobrowseAgent.connect", new
        {
            requestId = id,
            ticket,
            dotNetRef = _self
        });
    }

    private async Task EndAsync()
    {
        await JS.InvokeVoidAsync("cobrowseAgent.end");
    }

    private async Task SendTextAsync()
    {
        await JS.InvokeVoidAsync("cobrowseAgent.sendText");
    }

    private async Task ScrollDownAsync()
    {
        await JS.InvokeVoidAsync("cobrowseAgent.scrollDown");
    }

    [JSInvokable]
    public Task OnAgentState(string state, string? message)
    {
        if (state is "error" or "disconnected")
            _error = message;

        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnSessionState(bool customerOnline, bool view, bool control)
    {
        // Connection state is already on the status pills in the session list.
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnConsent(bool view, bool control)
    {
        // Consent is already on the status pills in the session list.
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnCustomerState(bool online)
    {
        // Customer online/offline is already on the status pills.
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnSessionEnded(string reason, string? message)
    {
        _selectedRequestId = null;
        _notice = message ?? "The support session ended.";
        Refresh();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Notifier.Changed -= OnQueueChanged;

        try
        {
            await JS.InvokeVoidAsync("cobrowseAgent.disconnect");
        }
        catch
        {
            // The circuit may already be gone.
        }

        _self?.Dispose();
    }
}
